# ==============================================================================
# Financial & Market Analyst Agent — Environment Configuration Template
# Copy this file to .env and fill in your free API keys:
#   cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Service Endpoints (Local Defaults)
STREAMLIT_PORT=8501
AGENT_PORT=8000
MARKET_GATEWAY_PORT=8004
MARKET_GATEWAY_URL=http://localhost:8004
AGENT_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 1. Groq Cloud LPU (Free Tier at https://console.groq.com)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_REASONING_MODEL=qwen/qwen3.8-27b
GROQ_ROUTER_MODEL=qwen/qwen3.8-27b
GROQ_GUARD_MODEL=llama-guard-3-8b

# ------------------------------------------------------------------------------
# 2. Hugging Face Serverless (Free Token at https://huggingface.co/settings/tokens)
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
HF_SHIELD_MODEL=meta-llama/Prompt-Guard-86M
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# 3. Upstash Serverless Data Tier ($0 Cost Tier at https://console.upstash.com)
# ------------------------------------------------------------------------------
# Upstash Redis (Session History & Audit Trail)
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Upstash Vector (SEC 10-K RAG Index)
UPSTASH_VECTOR_REST_URL=https://your-vector-endpoint.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# ------------------------------------------------------------------------------
# 4. Langfuse LLMOps Platform (Local K8s LoadBalancer at http://localhost:8092)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:8092
DEEPEVAL_THRESHOLD=0.90

# ------------------------------------------------------------------------------
# 5. GitHub Container Registry (GHCR) Authentication
# ------------------------------------------------------------------------------
GITHUB_USER=mamunhabib
GITHUB_PAT=your_github_personal_access_token_with_packages_scope
